{
  "name": "@suno/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Backend Convex Suno Studio (baza, akcje, scheduler, auth).",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "cd ../.. && convex dev",
    "deploy": "cd ../.. && convex deploy",
    "codegen": "cd ../.. && convex codegen",
    "typecheck": "tsc -p convex/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@suno/core": "*",
    "convex": "^1.31.0"
  },
  "nx": {
    "name": "backend",
    "tags": [
      "scope:backend",
      "type:lib"
    ],
    "projectType": "library"
  }
}
