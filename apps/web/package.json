{
  "name": "@suno/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --mode tauri-dev",
    "build": "tsc -p tsconfig.json && vite build",
    "build:tauri": "tsc -p tsconfig.json && vite build --mode tauri",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@sentry/react": "^11.6.0",
    "@suno/backend": "*",
    "@suno/core": "*",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "~2.4.3",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "convex": "^1.31.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "nx": {
    "name": "web",
    "tags": [
      "scope:frontend",
      "type:app"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "build:tauri": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-tauri"
        ]
      }
    },
    "projectType": "application"
  }
}
