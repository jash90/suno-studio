{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suno Studio",
  "version": "0.2.0",
  "identifier": "com.bartlomiejzimny.suno-studio",
  "build": {
    "beforeDevCommand": "npx nx run web:dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx nx run web:build:tauri",
    "frontendDist": "../../web/dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Suno Studio",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:3210 http://127.0.0.1:3211 ws://127.0.0.1:3210",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob: https:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "worker-src": "'self' blob:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Studio piosenek AI: teksty, generacja muzyki, albumy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
