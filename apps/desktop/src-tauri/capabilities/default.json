{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Uprawnienia głównego okna: dane studia w $APPDATA, zapis plików do folderów użytkownika (wybrane w dialogu są dopisywane do scope), HTTP bez CORS, store, aktualizacje",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    },
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "store:default",
    "updater:default",
    "process:allow-restart",
    "fs:allow-remove",
    "fs:allow-stat",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$AUDIO/**"
        },
        {
          "path": "$HOME/Music/**"
        }
      ]
    }
  ]
}
